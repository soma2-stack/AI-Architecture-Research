+def segment_hit_time(projectile, entity):
+    dx = projectile.x - projectile.previous_x
+    dy = projectile.y - projectile.previous_y
+    length_sq = dx * dx + dy * dy
+    if length_sq == 0:
+        return 0.0 if overlap(projectile, entity) else None
+    t = ((entity.x - projectile.previous_x) * dx + (entity.y - projectile.previous_y) * dy) / length_sq
+    t = max(0.0, min(1.0, t))
+    px = projectile.previous_x + t * dx
+    py = projectile.previous_y + t * dy
+    return t if distance(px, py, entity.x, entity.y) <= projectile.radius else None
+
