+def bulk_complete_with_undo(tasks, task_ids):
+    """Complete a batch and return an undo token that restores each prior state."""
+    wanted=set(task_ids); selected=[task for task in tasks if task.task_id in wanted]
+    if len(selected)!=len(wanted): raise MissingTask("one or more tasks do not exist")
+    prior=[(task,task.completed) for task in selected]
+    for task,_ in prior: task.completed=True
+    return prior
+
+def undo_bulk_complete(token):
+    for task,was_completed in token: task.completed=was_completed
+    return len(token)
