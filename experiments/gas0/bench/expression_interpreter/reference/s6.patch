+def validate_program(program):
+    """Reject every node outside the interpreter's explicit syntax tree."""
+    from .errors import EvalError
+    from .nodes import Assign, Binary, Call, FunctionDef, Name, Number, Program, Unary
+    allowed=(Assign,Binary,Call,FunctionDef,Name,Number,Program,Unary)
+    def visit(node):
+        if not isinstance(node,allowed):
+            raise EvalError("unsupported syntax tree node")
+        if isinstance(node,Program):
+            children=node.statements
+        elif isinstance(node,Assign):
+            children=(node.value,)
+        elif isinstance(node,Binary):
+            children=(node.left,node.right)
+        elif isinstance(node,Unary):
+            children=(node.operand,)
+        elif isinstance(node,Call):
+            children=node.arguments
+        elif isinstance(node,FunctionDef):
+            children=(node.body,)
+        else:
+            children=()
+        for child in children: visit(child)
+    visit(program)
+    return True
