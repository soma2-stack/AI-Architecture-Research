+def use_tonic(player,item_id):
+    item=next((row for row in player.inventory if row.item_id==item_id),None)
+    if item is None: raise KeyError(item_id)
+    if item.kind!="tonic": raise InvalidAction("item is not a tonic")
+    player.max_hp+=2
+    player.hp=min(player.max_hp,player.hp+2)
+    player.inventory.remove(item)
+    return player.max_hp,player.hp
