+def use_cleansing_charm(player,book,item_id):
+    item=next((row for row in player.inventory if row.item_id==item_id),None)
+    if item is None: raise KeyError(item_id)
+    if item.kind!="charm": raise ValueError("item is not a cleansing charm")
+    book.remove(player.actor_id); player.heal(1); player.inventory.remove(item)
+    return player.hp
